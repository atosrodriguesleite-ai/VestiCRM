// VestiCRM — Schema multi-tenant para CRM de moda
// Dev: SQLite. Produção: trocar provider para "postgresql" (schema é compatível).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa (tenant). Toda entidade de negócio referencia companyId — nenhuma
// consulta do app pode cruzar empresas (ver src/lib/scope.ts).
// ---------------------------------------------------------------------------
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("pro")
  whatsapp  String? // número exibido no catálogo público (wa.me)
  tagline   String? // frase de apresentação do catálogo público
  minOrder  Int     @default(0) // pedido mínimo (peças) no catálogo público; 0 = sem mínimo
  createdAt DateTime @default(now())

  // Identidade visual do catálogo público (100% personalizável pelo lojista)
  logoUrl          String? // logo da marca (URL ou data-URL enviada pelo lojista)
  catalogPrimary   String  @default("#4B3621") // cor principal (topbar, botões)
  catalogSecondary String  @default("#E7DCCC") // cor de apoio (chips, destaques)
  catalogBg        String  @default("#FFFFFF") // fundo
  catalogFont      String  @default("montserrat") // montserrat | inter | poppins | playfair | lora

  // Lead Intake Engine — configuração de entrada de leads
  intakeDistribution  String  @default("ROUND_ROBIN") // ROUND_ROBIN | FIXED
  intakeDefaultUserId String? // vendedor fixo (quando FIXED)
  intakeLastUserId    String? // ponteiro do rodízio
  intakeSlaMinutes    Int     @default(60) // prazo do primeiro atendimento
  intakeOppPolicy     String  @default("SE_NAO_HOUVER_ABERTA") // SEMPRE | SE_NAO_HOUVER_ABERTA | NUNCA

  users         User[]
  customers     Customer[]
  tags          Tag[]
  interests     Interest[]
  pipelines     Pipeline[]
  opportunities Opportunity[]
  conversations Conversation[]
  templates     MessageTemplate[]
  tasks         Task[]
  sales         Sale[]
  campaigns     Campaign[]
  products      Product[]
  orders        Order[]
  inventoryMovs InventoryMovement[]
  customerEvents CustomerEvent[]
  originRules    OriginRule[]
  catalogColors  CompanyColor[]
  catalogSizes   CompanySize[]
}

// Biblioteca de cores do lojista: ele cria a tonalidade e dá o nome
model CompanyColor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  hex       String  @default("#C9BEB0")

  @@unique([companyId, name])
}

// Tamanhos do lojista (P, M, G, GG, 36, 38, Único... o que fizer sentido)
model CompanySize {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  order     Int     @default(0)

  @@unique([companyId, name])
}

// Timeline do cliente: "Lead criado via WhatsApp", "Nova interação via Site"...
model CustomerEvent {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String // LEAD_CRIADO | NOVA_INTERACAO | OPORTUNIDADE | PEDIDO | OUTRO
  channel     Origin?
  description String
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([companyId, createdAt])
}

// Em qual etapa do funil cada origem entra (sem regra = primeira etapa)
model OriginRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origin    Origin
  stageId   String?
  stage     Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([companyId, origin])
}

// SUPERADMIN enxerga todas as empresas; demais papéis ficam restritos à sua.
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  SELLER
  SUPPORT
}

model User {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(SELLER)
  active       Boolean @default(true)
  color        String  @default("#6366f1")
  createdAt    DateTime @default(now())

  customers     Customer[]     @relation("CustomerOwner")
  opportunities Opportunity[]  @relation("OppOwner")
  conversations Conversation[] @relation("ConvAssignee")
  tasks         Task[]         @relation("TaskAssignee")
  sales         Sale[]         @relation("SaleSeller")
  messages      Message[]
  orders        Order[]        @relation("OrderSeller")
  orderEvents   OrderEvent[]

  @@index([companyId])
}

enum CustomerType {
  VAREJO
  ATACADO
  REVENDEDORA
  LOJISTA
  BOUTIQUE
  SACOLEIRA
}

enum Origin {
  WHATSAPP
  CATALOGO_PUBLICO
  INSTAGRAM
  FACEBOOK
  SITE
  NUVEMSHOP
  BLING
  MARKETPLACE
  INDICACAO
  LOJA_FISICA
  TRAFEGO_PAGO
  GOOGLE
  EVENTO
  MANUAL
  TELEGRAM
  EMAIL
  SMS
}

model Customer {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  city           String?
  state          String?
  type           CustomerType @default(VAREJO)
  origin         Origin       @default(WHATSAPP)
  notes          String?
  preferredSize  String?
  preferredColors String?
  lastPurchaseAt DateTime?
  nextContactAt  DateTime?
  lastContactAt  DateTime?
  ownerId        String?
  owner          User?        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  tags          CustomerTag[]
  interests     CustomerInterest[]
  opportunities Opportunity[]
  conversations Conversation[]
  tasks         Task[]
  sales         Sale[]
  orders        Order[]
  events        CustomerEvent[]

  @@index([companyId])
  @@index([companyId, ownerId])
}

model Tag {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#8b5cf6")

  customers CustomerTag[]

  @@unique([companyId, name])
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

// Produtos/categorias de interesse (vestidos, moda fitness, atacado...)
model Interest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  customers CustomerInterest[]

  @@unique([companyId, name])
}

model CustomerInterest {
  customerId String
  interestId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([customerId, interestId])
}

model Pipeline {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String  @default("Funil de vendas")

  stages Stage[]

  @@index([companyId])
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  color      String   @default("#6366f1")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)

  opportunities Opportunity[]
  originRules   OriginRule[]

  @@index([pipelineId])
}

enum OppStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id])
  title             String
  value             Float     @default(0)
  status            OppStatus @default(OPEN)
  lostReason        String?
  ownerId           String?
  owner             User?     @relation("OppOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastInteractionAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  closedAt          DateTime?

  tasks Task[]
  sales Sale[]

  @@index([companyId, status])
  @@index([stageId])
}

enum ConversationStatus {
  OPEN
  WAITING_CLIENT
  WAITING_PAYMENT
  CLOSED
}

// Canal de comunicação (Communication Engine)
enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  EMAIL
  SMS
}

enum ConversationPriority {
  BAIXA
  NORMAL
  ALTA
}

model Conversation {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?                @relation("ConvAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  channel        Channel              @default(WHATSAPP)
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  unreadCount    Int                  @default(0)
  lastMessageAt  DateTime             @default(now())
  lastInboundAt  DateTime? // última msg do cliente → tempo aguardando vendedor
  lastOutboundAt DateTime? // última msg da loja → tempo aguardando cliente
  createdAt      DateTime             @default(now())

  messages Message[]
  orders   Order[]

  @@index([companyId, status])
}

enum MessageDirection {
  IN
  OUT
}

// NOTE = nota interna (visível só para a equipe, nunca enviada ao cliente)
enum MessageKind {
  TEXT
  NOTE
}

enum MessageMedia {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  TEMPLATE
}

// Ciclo de vida da entrega (Cloud API: sent → delivered → read)
enum MessageStatus {
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  REENVIADA
  RECEBIDA
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String? // id da mensagem no provedor (wamid...)
  channel        Channel          @default(WHATSAPP)
  direction      MessageDirection @default(OUT)
  kind           MessageKind      @default(TEXT)
  mediaType      MessageMedia     @default(TEXT)
  body           String
  mediaUrl       String?
  fileName       String?
  reaction       String? // emoji de reação
  replyToId      String? // resposta a outra mensagem
  replyTo        Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]        @relation("MessageReply")
  status         MessageStatus    @default(ENVIADA)
  error          String?
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([externalId])
}

enum TemplateCategory {
  PRIMEIRO_ATENDIMENTO
  CATALOGO
  COBRANCA
  POS_VENDA
  RECOMPRA
  PROMOCAO
  CLIENTE_FRIO
  ANIVERSARIO
  OUTRO
}

model MessageTemplate {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  TemplateCategory @default(OUTRO)

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Communication Engine — eventos, credenciais e auditoria
// ---------------------------------------------------------------------------

// Log de todo tráfego da engine: webhooks recebidos, envios, erros, latência
model CommEvent {
  id         String   @id @default(cuid())
  companyId  String?
  channel    Channel  @default(WHATSAPP)
  direction  String // IN | OUT
  type       String // message.received | message.sent | status.update | webhook.error ...
  status     String // OK | ERRO
  payload    String? // JSON do que chegou/saiu
  response   String? // JSON da resposta do provedor
  error      String?
  durationMs Int      @default(0)
  attempts   Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([type])
}

// Credenciais por empresa — valores sensíveis criptografados (AES-256-GCM)
model CommSettings {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  activeProvider     String   @default("MOCK") // MOCK | CLOUD_API
  metaAppId          String?
  metaAppSecret      String? // criptografado
  businessManagerId  String?
  phoneNumberId      String?
  verifyToken        String? // criptografado
  accessToken        String? // criptografado
  webhookSecret      String? // criptografado
  instagramAccountId String?
  facebookPageId     String?
  telegramBotToken   String? // criptografado
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String? // criptografado
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Tracking Engine — Inteligência Comercial
// ---------------------------------------------------------------------------

// Visitante do catálogo (anônimo até informar o telefone; depois unificado)
model Visitor {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String? // preenchido no identify (unifica a navegação)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  visits      Int       @default(1)

  sessions TrackSession[]

  @@index([companyId, customerId])
}

// Sessão de navegação no catálogo (uma visita)
model TrackSession {
  id          String   @id @default(cuid())
  companyId   String
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  customerId  String? // denormalizado após identify
  ref         String? // ?ref=joao / campanha-verao / qr-vitrine
  channel     String  @default("direto") // instagram|google|facebook|whatsapp|qr|indicacao|site|direto|...
  sellerId    String? // vendedor dono do link
  campaignId  String? // campanha dona do link
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referer     String?
  device      String? // mobile|desktop|tablet
  os          String?
  browser     String?
  city        String?
  state       String?
  country     String?
  ipMasked    String? // LGPD: último octeto zerado
  replayId    String? // estrutura pronta p/ replay de sessão (futuro)
  startedAt   DateTime @default(now())
  lastEventAt DateTime @default(now())
  pages       Int      @default(0)
  productsViewed Int   @default(0)
  cartAdds    Int      @default(0)
  cartRemoves Int      @default(0)
  cartValue   Float    @default(0)
  converted   Boolean  @default(false) // enviou pedido

  events TrackEvent[]

  @@index([companyId, startedAt])
  @@index([companyId, sellerId])
  @@index([companyId, campaignId])
  @@index([visitorId])
}

// Evento da jornada — SEMPRE gravado via Tracking Engine
model TrackEvent {
  id          String       @id @default(cuid())
  companyId   String
  sessionId   String
  session     TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String // page_view|category_view|product_view|image_zoom|color_select|size_select|qty_change|cart_add|cart_remove|cart_open|cart_close|checkout_start|order_submitted|order_abandoned|heartbeat
  productId   String?
  productName String?
  category    String?
  color       String?
  size        String?
  qty         Int?
  value       Float?
  meta        String? // JSON extra
  createdAt   DateTime     @default(now())

  @@index([companyId, type, createdAt])
  @@index([sessionId])
}

// Campanhas/links inteligentes (cada um gera link + QR Code)
model TrackCampaign {
  id        String   @id @default(cuid())
  companyId String
  name      String
  slug      String // valor do ?ref=
  channel   String  @default("campanha") // instagram|qr|google|...
  ownerId   String? // responsável
  goal      Float   @default(0) // meta de faturamento
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, slug])
  @@index([companyId])
}

// Auditoria: quem alterou credenciais e quais campos (nunca os valores)
model CommAudit {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  userName  String
  action    String // ex.: "Atualizou credenciais"
  fields    String // nomes dos campos alterados, separados por vírgula
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum TaskType {
  LIGAR
  ENVIAR_CATALOGO
  COBRAR_PAGAMENTO
  POS_VENDA
  REATIVAR
  ENVIAR_NOVIDADES
  CONFIRMAR_ENTREGA
  FOLLOW_UP
  OUTRO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

model Task {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title         String
  type          TaskType     @default(FOLLOW_UP)
  dueAt         DateTime
  priority      TaskPriority @default(MEDIA)
  status        TaskStatus   @default(PENDENTE)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  autoRule      String?      // preenchido quando a tarefa foi criada por automação
  createdAt     DateTime     @default(now())

  @@index([companyId, status, dueAt])
}

model Sale {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sellerId      String?
  seller        User?        @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  total         Float
  category      String?
  description   String?
  createdAt     DateTime     @default(now())

  @@index([companyId, createdAt])
}

enum CampaignStatus {
  RASCUNHO
  ATIVA
  CONCLUIDA
}

// Campanhas de reativação: filtro salvo como JSON (dias sem compra, tipo,
// cidade, ticket mínimo, interesse...) + mensagem a disparar.
model Campaign {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  filterJson String         @default("{}")
  message    String
  status     CampaignStatus @default(RASCUNHO)
  createdAt  DateTime       @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Catálogo de produtos + Pedidos
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  category       String
  brand          String?
  collection     String?
  description    String?
  videoUrl       String?
  costPrice      Float    @default(0)
  wholesalePrice Float    @default(0) // preço atacado
  retailPrice    Float    @default(0) // preço varejo
  minQuantity    Int      @default(1) // qtd mínima (atacado)
  active         Boolean  @default(true)
  tags           String? // separadas por vírgula
  createdAt      DateTime @default(now())

  variants ProductVariant[]
  images   ProductImage[]
  items    OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId, active])
  @@index([companyId, category])
}

// Grade: cada combinação cor × tamanho com estoque próprio
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(0)

  items     OrderItem[]
  movements InventoryMovement[]

  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

enum OrderStatus {
  ORCAMENTO
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PRODUCAO
  SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Order {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number         Int // sequencial por empresa
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId       String?
  seller         User?        @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         OrderStatus  @default(ORCAMENTO)
  subtotal       Float        @default(0)
  discount       Float        @default(0)
  shippingFee    Float        @default(0)
  total          Float        @default(0)
  notes          String?
  createdAt      DateTime     @default(now())

  items    OrderItem[]
  payments Payment[]
  shipping Shipping?
  events   OrderEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // snapshot no momento da venda (produto pode mudar depois)
  name      String
  sku       String?
  imageUrl  String?
  color     String?
  size      String?
  quantity  Int
  unitPrice Float
  total     Float

  @@index([orderId])
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  DINHEIRO
  OUTRO
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  ESTORNADO
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(PIX)
  status    PaymentStatus @default(PENDENTE)
  amount    Float
  pixKey    String? // chave usada no BR Code do orçamento
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([orderId])
}

model Shipping {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       String? // transportadora, motoboy, correios, retirada...
  trackingCode String?
  address      String?
  city         String?
  state        String?
  zip          String?
  cost         Float     @default(0)
  shippedAt    DateTime?
  deliveredAt  DateTime?
}

// Timeline do pedido: criação, mudanças de status, pagamento, envio...
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String // CRIADO, STATUS, PAGAMENTO, ENVIO, NOTA
  description String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model InventoryMovement {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  type      MovementType
  quantity  Int // sempre positivo; o tipo dá a direção
  reason    String?
  createdAt DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([variantId])
}
