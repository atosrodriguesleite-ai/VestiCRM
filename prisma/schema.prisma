// VestiCRM — Schema multi-tenant para CRM de moda
// Banco: PostgreSQL (dev e produção). Evolução do schema via `prisma migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa (tenant). Toda entidade de negócio referencia companyId — nenhuma
// consulta do app pode cruzar empresas (ver src/lib/scope.ts).
// ---------------------------------------------------------------------------
model Company {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  plan              String   @default("pro")
  whatsapp          String? // número exibido no catálogo público (wa.me)
  tagline           String? // frase de apresentação do catálogo público
  minOrder          Int      @default(0) // pedido mínimo em PEÇAS (quando minOrderMode = PECAS)
  minOrderMode      String   @default("NONE") // trava do catálogo: NONE | PECAS | VALOR
  // Recuperação de carrinhos: a 1ª mensagem sai SOZINHA (2h após o abandono,
  // em horário comercial, com o ritmo anti-bloqueio do WhatsApp). Nasce
  // DESLIGADA: mensagem automática para cliente é decisão da loja, não nossa.
  recoveryAuto      Boolean  @default(false)
  minOrderValue     Float    @default(0) // pedido mínimo em R$ (quando minOrderMode = VALOR)
  // Base da comissão. As DUAS opções são sem frete — o frete nunca remunera
  // vendedora, e isso é estrutura, não configuração:
  //   SUBTOTAL = valor das peças, ANTES do desconto
  //   VENDIDO  = peças − desconto + acréscimo (o valor realmente vendido)
  commissionBase    String   @default("SUBTOTAL")
  lowStockThreshold Int      @default(5) // alerta de estoque: avisa quando a variação chega a X peças
  productionEnabled Boolean  @default(false) // módulo Produção (pago à parte; super admin ativa por loja)
  marketingEnabled  Boolean  @default(false) // módulo Marketing (pago à parte; super admin ativa por loja)
  mediaLibraryEnabled Boolean @default(false) // Biblioteca de imagens (super admin ativa por loja)
  shippingEnabled   Boolean  @default(false) // módulo Envios/Melhor Envio (pago à parte; super admin ativa por loja)
  cutPlanEnabled    Boolean  @default(false) // módulo Plano de Corte (pago à parte; super admin ativa por loja)
  aiSalesEnabled    Boolean  @default(false) // módulo IA de Vendas (pago à parte; super admin ativa por loja)
  suspended         Boolean  @default(false) // acesso bloqueado pelo super admin (ex.: inadimplência)
  // última rodada das automações desta loja. É a TRAVA ATÔMICA que faz o
  // motor rodar de carona no tráfego normal, no máximo uma vez por dia, sem
  // gastar uma das 2 vagas de cron da Vercel (que já estão as duas ocupadas).
  automationsRunAt  DateTime?
  createdAt         DateTime @default(now())

  // Identidade visual do catálogo público (100% personalizável pelo lojista)
  logoUrl          String? // logo da marca (URL ou data-URL enviada pelo lojista)
  catalogPrimary   String  @default("#4B3621") // cor principal (topbar, botões)
  catalogSecondary String  @default("#E7DCCC") // cor de apoio (chips, destaques)
  catalogBg        String  @default("#FFFFFF") // fundo
  catalogFont      String  @default("montserrat") // montserrat | inter | poppins | playfair | lora
  catalogLogoSize  String  @default("normal") // normal | grande (logo grande centralizado no topo)
  catalogHideOutOfStock Boolean @default(false) // esconder do catálogo os produtos sem estoque (indisponíveis)
  // Loja SEM variação de cor (semijoias, acessórios): o catálogo esconde a
  // bolinha e o nome da cor — por loja, desligado por padrão (ninguém muda)
  catalogHideColors Boolean @default(false)
  categoryOrder    String  @default("") // ordem das categorias no catálogo (JSON array); vazio = ordem natural
  extraCategories  String  @default("") // categorias criadas à mão (JSON array), inclusive sem produtos ainda
  // Descrição de cada categoria no catálogo público (JSON objeto nome→texto).
  // Antes o catálogo mostrava a descrição do PRIMEIRO produto da categoria —
  // que mudava sozinha quando a ordem mudava ou quando a Nuvemshop
  // sobrescrevia o produto. Agora o texto é da categoria e não muda sem a
  // lojista mandar. Sem texto salvo, cai no comportamento antigo.
  categoryDescriptions String @default("{}")
  // TIPO DE PEÇA — o guarda-chuva das categorias no catálogo público
  // ("Blusas" agrupa Regata Alça, Baby Look, Ombro Único). JSON objeto
  // categoria→tipo: amarrado pela CATEGORIA, não peça por peça, então peça
  // nova já nasce no guarda-chuva certo. A ORDEM dos tipos sai da ordem das
  // categorias (categoryOrder) — uma régua só, nada para sincronizar.
  categoryTypes        String @default("{}")

  // Lead Intake Engine — configuração de entrada de leads
  intakeDistribution  String  @default("ROUND_ROBIN") // ROUND_ROBIN | FIXED
  intakeDefaultUserId String? // vendedor fixo (quando FIXED)
  intakeLastUserId    String? // ponteiro do rodízio
  intakeSlaMinutes    Int     @default(60) // prazo do primeiro atendimento
  intakeOppPolicy     String  @default("SE_NAO_HOUVER_ABERTA") // SEMPRE | SE_NAO_HOUVER_ABERTA | NUNCA

  users          User[]
  customers      Customer[]
  abandonedCarts AbandonedCart[]
  tags           Tag[]
  interests      Interest[]
  pipelines      Pipeline[]
  opportunities  Opportunity[]
  conversations  Conversation[]
  templates      MessageTemplate[]
  tasks          Task[]
  sales          Sale[]
  campaigns      Campaign[]
  products       Product[]
  orders         Order[]
  mediaAssets    MediaAsset[]
  inventoryMovs  InventoryMovement[]
  customerEvents CustomerEvent[]
  originRules    OriginRule[]
  catalogColors  CompanyColor[]
  catalogSizes   CompanySize[]
  waConsents     WhatsappConsent[]
  nuvemshop      NuvemshopConnection?
  jueri          JueriConnection?
  mercadoPago    MercadoPagoConnection?
  bling          BlingConnection?
  melhorEnvio    MelhorEnvioConnection?
  billing        CompanyBilling?
  modules        CompanyModule[]
  adCreatives    AdCreative[]
  promoCatalogs  PromoCatalog[]
  fabrics        Fabric[]
  cutTickets     CutTicket[]
  fabricScraps   FabricScrap[]
  cutPlanModels  CutPlanModel[]
  cutPlanRuns    CutPlanRun[]
  marketingCampaigns MarketingCampaign[]
  bioPage        BioPage?
  shippingMethods ShippingMethod[]
  setores        Setor[]
  notifications  Notification[]
  portfolioProducts PortfolioProduct[]
  aiSettings     AiSettings?
  aiUsage        AiUsage[]
}

/// PORTFÓLIO DE PRODUTOS E SERVIÇOS (só Super Admin, empresa-plataforma).
///
/// É o "manual" dos serviços que a plataforma vende junto com o CRM: o que é,
/// para quem serve, como vender, quanto custa entregar e o passo a passo da
/// entrega. Não é o catálogo de roupas das lojas (esse é `Product`) — aqui
/// não há estoque, foto nem pedido: é conhecimento comercial e operacional.
///
/// Cada bloco da página vira uma tabela filha, para que a informação seja
/// consultável e somável (horas, custo, margem) em vez de texto solto.
model PortfolioProduct {
  id        String @id @default(cuid())
  companyId String

  // ---- Cabeçalho ----
  name      String // "Profissional de Gestão de Mídia Paga"
  shortDesc String? // resumo de uma linha (aparece no card da listagem)
  category  String? // agrupamento livre — o dono define os dele
  status    String  @default("DISPONIVEL") // DISPONIVEL | RASCUNHO | DESCONTINUADO
  duration  String? // "Recorrente", "Pontual", "3 meses"...
  baseValue Float? // valor base cobrado; null = "a definir"
  ownerName String? // responsável pelo produto

  // ---- Visão geral ----
  fullDesc    String? // descrição completa
  icpText     String? // ICP (perfil de cliente ideal)
  icpForWhom  String? // para quem serve
  icpHowValue String? // como entregar valor

  // ---- Aspectos técnicos ----
  scope          String? // escopo
  deliveryFormat String? // formato de entrega
  teamInvolved   String? // time envolvido

  // ---- Vender / Entregar (texto corrido) ----
  howToSell    String? // "como eu vendo?"
  howToDeliver String? // "como eu entrego?"
  notes        String? // observações livres

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants    PortfolioVariant[]
  positions   PortfolioPosition[]
  steps       PortfolioStep[]
  materials   PortfolioMaterial[]
  dreLines    PortfolioDreLine[]
  salesFrames PortfolioSalesFrame[]

  @@index([companyId, name])
}

/// Variação do mesmo produto (ex.: "Basic", "E-commerce", "Invest. 2-5K").
/// Quando existe variação, é ela que carrega o preço praticado.
model PortfolioVariant {
  id          String  @id @default(cuid())
  productId   String
  name        String
  baseValue   Float?
  description String?
  order       Int     @default(0)

  product PortfolioProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Posições alocadas: quem executa, quantas horas e quanto custa.
/// A soma das linhas é o custo de entrega do produto.
model PortfolioPosition {
  id        String  @id @default(cuid())
  productId String
  role      String // cargo/posição
  hours     Float   @default(0) // horas alocadas
  cost      Float   @default(0) // custo (CMV) da posição
  note      String?
  order     Int     @default(0)

  product PortfolioProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Linha da DRE do produto. É livre de propósito: cada linha tem rótulo,
/// sinal e valor, para caber qualquer modelo de conta sem engessar.
model PortfolioDreLine {
  id        String  @id @default(cuid())
  productId String
  label     String // "(-) Impostos sobre Receita"
  sign      String  @default("NEUTRO") // ENTRADA | SAIDA | RESULTADO | NEUTRO
  percent   Float? // % quando a linha for percentual
  value     Float? // valor em R$
  highlight Boolean @default(false) // destaca a linha (subtotais)
  order     Int     @default(0)

  product PortfolioProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Etapa de entrega: o passo a passo operacional, com quem executa e o
/// link do POP (procedimento) de cada tarefa.
model PortfolioStep {
  id        String  @id @default(cuid())
  productId String
  stage     String? // agrupamento ("Principais rotinas", "Onboarding"...)
  task      String // a tarefa em si
  detail    String? // o quê / observação
  executor  String? // quem executa
  estimate  String? // estimativa (horas, dias, "9")
  popUrl    String? // link do procedimento
  order     Int     @default(0)

  product PortfolioProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Material de apoio — sempre um LINK, nunca arquivo hospedado aqui.
/// Decisão consciente: manter mídia fora do banco (a dívida nº 1 do sistema).
model PortfolioMaterial {
  id        String  @id @default(cuid())
  productId String
  kind      String  @default("VENDAS") // VENDAS | OPERACIONAL | TREINAMENTO
  title     String
  tag       String? // etiqueta livre ("Comercial", "Material")
  url       String?
  order     Int     @default(0)

  product PortfolioProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Quadro de vendas: tabela livre para os mapas de argumentação
/// (mapa de caso de uso, roteiro de descoberta...). Cada quadro tem um
/// título e linhas com até três colunas — cabe tanto o quadro de 2 colunas
/// quanto o roteiro de 4.
model PortfolioSalesFrame {
  id        String  @id @default(cuid())
  productId String
  title     String
  subtitle  String?
  colA      String? // cabeçalho da 1ª coluna de conteúdo
  colB      String?
  colC      String?
  order     Int     @default(0)

  product PortfolioProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  rows    PortfolioSalesFrameRow[]

  @@index([productId])
}

model PortfolioSalesFrameRow {
  id      String  @id @default(cuid())
  frameId String
  label   String // "P – Problema", "S – Situação"
  valueA  String?
  valueB  String?
  valueC  String?
  order   Int     @default(0)

  frame PortfolioSalesFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([frameId])
}

// Meios de envio cadastrados pela loja (Correios ou Transportadora): Sedex,
// Pac, Loggi, Jadlog... Aparecem no seletor de envio de cada pedido, do mesmo
// jeito que a forma de pagamento. Gerência liberada para admin/gerente e para
// o perfil Suporte.
model ShippingMethod {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("TRANSPORTADORA") // CORREIOS | TRANSPORTADORA
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId, active])
}

// Biblioteca de cores do lojista: ele cria a tonalidade e dá o nome
model CompanyColor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  hex       String  @default("#C9BEB0")

  @@unique([companyId, name])
}

// Tamanhos do lojista (P, M, G, GG, 36, 38, Único... o que fizer sentido)
model CompanySize {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  order     Int     @default(0)

  @@unique([companyId, name])
}

// Timeline do cliente: "Lead criado via WhatsApp", "Nova interação via Site"...
model CustomerEvent {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String // LEAD_CRIADO | NOVA_INTERACAO | OPORTUNIDADE | PEDIDO | OUTRO
  channel     Origin?
  description String
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([companyId, createdAt])
}

// Em qual etapa do funil cada origem entra (sem regra = primeira etapa)
model OriginRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origin    Origin
  stageId   String?
  stage     Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([companyId, origin])
}

// SUPERADMIN enxerga todas as empresas; demais papéis ficam restritos à sua.
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  SELLER
  SUPPORT
}

model User {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  email          String   @unique
  username       String?  @unique // login alternativo sem e-mail (ex.: "maria")
  passwordHash   String
  role           Role     @default(SELLER)
  active         Boolean  @default(true)
  color          String   @default("#6366f1")
  avatarUrl      String? // foto do usuário (data-URL) — opcional; sem foto usa iniciais
  commissionRate Float    @default(0) // % de comissão sobre as vendas do vendedor
  monthlyGoal    Float    @default(0) // meta de vendas do mês (R$) — 0 = sem meta
  prefersDark    Boolean  @default(false) // modo escuro — escolha individual de cada usuário
  lastActiveAt   DateTime? // último acesso real ao sistema (não conta impersonação do super admin)
  createdAt      DateTime @default(now())

  customers     Customer[]     @relation("CustomerOwner")
  opportunities Opportunity[]  @relation("OppOwner")
  conversations Conversation[] @relation("ConvAssignee")
  tasks         Task[]         @relation("TaskAssignee")
  sales         Sale[]         @relation("SaleSeller")
  messages      Message[]
  orders        Order[]        @relation("OrderSeller")
  orderEvents   OrderEvent[]
  setores       Setor[]        @relation("SetorUsers") // atendimento: setores do vendedor
  notifications Notification[] @relation("UserNotifications")

  @@index([companyId])
}

// Notificação interna (sino do topo): menção em nota interna, chamado
// atribuído/transferido para você, etc. É só do CRM — nunca vai ao cliente.
model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String // destinatário
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String // MENTION | ASSIGN | PEDIDO
  title     String
  body      String   @default("")
  convId    String? // conversa relacionada (para abrir ao clicar)
  orderId   String? // pedido relacionado (tem prioridade sobre a conversa)
  actorName String? // quem gerou (nome do vendedor)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([companyId])
}

/// Vigia do sistema: registro de erros de produção (painel Saúde do Super
/// Admin). Nunca guarda dados sensíveis — só mensagem, rota e stack curto.
model ErrorLog {
  id        String   @id @default(cuid())
  source    String // server (erro de rota) | watchdog (vigia) | client
  path      String? // rota/tela onde estourou
  message   String
  detail    String? // stack truncado
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Estado do vigia (linha única id="main"). O vigia roda "de carona" no
/// tráfego normal (máx. 1x a cada poucos minutos) — Vercel Hobby só permite
/// 2 crons diários, então NÃO usar cron para isso.
model SystemHealth {
  id                 String    @id
  watchdogRunAt      DateTime? // última rodada do vigia (trava anti-corrida)
  evolutionOk        Boolean   @default(true) // servidor Evolution no ar?
  evolutionDownSince DateTime?
  errorAlertAt       DateTime? // último push de erro (anti-spam)
  updatedAt          DateTime  @updatedAt
}

// Setor/Departamento de atendimento (Central de Atendimento — WhatsApp).
// A loja cria os seus (Vendas, Financeiro, Suporte...). Cada número conectado
// tem um setor padrão, e cada chamado (conversa) pertence a um setor.
model Setor {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  users         User[]         @relation("SetorUsers")
  conversations Conversation[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum CustomerType {
  VAREJO
  ATACADO
  REVENDEDORA
  LOJISTA
  BOUTIQUE
  SACOLEIRA
}

enum Origin {
  WHATSAPP
  CATALOGO_PUBLICO
  INSTAGRAM
  FACEBOOK
  SITE
  NUVEMSHOP
  BLING
  MARKETPLACE
  INDICACAO
  LOJA_FISICA
  TRAFEGO_PAGO
  GOOGLE
  EVENTO
  MANUAL
  TELEGRAM
  EMAIL
  SMS
}

// Afiliado da PLATAFORMA (painel do Super Admin): divulga o AtacadoPro com
// um link próprio (?utm_campaign=<slug>) e cada lead que entrar por ele fica
// atribuído aqui — assim dá para saber a quem pagar comissão. O valor do
// acordo fica em notes (negociado caso a caso).
model Affiliate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // código usado no link de divulgação
  phone     String?
  pixKey    String? // chave PIX para pagamento da comissão
  notes     String? // acordo combinado (implantação/recorrente)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  customers Customer[]
}

model Customer {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  // DOCUMENTO: CPF e CNPJ em campos SEPARADOS, e não um só "CPF ou CNPJ".
  // A cliente lojista costuma ter os dois (CNPJ da loja e CPF da titular), e
  // cada transportadora/nota exige um deles: o Melhor Envio manda CPF em
  // `document` e CNPJ em `company_document`, e a NF-e muda de pessoa física
  // para jurídica. Com um campo só, guardar um apagava o outro.
  cpf             String?
  cnpj            String?
  zip             String? // CEP
  street          String?
  streetNumber    String?
  complement      String? // complemento (apto, bloco, loja, sala)
  district        String? // bairro
  city            String?
  state           String?
  type            CustomerType @default(VAREJO)
  origin          Origin       @default(WHATSAPP)
  notes           String?
  preferredSize   String?
  preferredColors String?
  // data de nascimento — o disparo de aniversário é o de maior conversão
  // do ano numa loja de moda. Guarda só o dia/mês/ano do nascimento.
  birthDate       DateTime?
  // catálogo de revenda (PDF) — preferências lembradas por lojista:
  resaleMarkup    Float        @default(0) // margem de revenda (%)
  resaleRound     Boolean      @default(false) // arredondar preço para ,90
  resaleStoreName String? // nome da loja impresso no catálogo
  lastPurchaseAt  DateTime?
  nextContactAt   DateTime?
  lastContactAt   DateTime?
  // FOTO DO WHATSAPP: guardamos só o LINK que o WhatsApp serve (nunca a
  // imagem — foto no banco é a dívida técnica nº 1 daqui). O link vence, por
  // isso `photoSyncAt` marca quando foi conferido pela última vez; passando
  // da validade, o sistema busca de novo. Sem foto (cliente escondeu no
  // WhatsApp), fica nulo e a tela mostra as iniciais coloridas.
  photoUrl        String?
  photoSyncAt     DateTime?
  ownerId         String?
  owner           User?        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // código curto do link rastreado do catálogo (catalago.net/loja/vend/CODIGO)
  linkCode        String?      @unique @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 7)"))
  // afiliado que trouxe este lead (só usado na empresa-plataforma)
  affiliateId     String?
  affiliate       Affiliate?   @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  // campanha de aquisição (módulo Marketing): de qual campanha este lead veio
  campaignId      String?
  campaign        MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // canal de aquisição da PLATAFORMA (só na empresa-plataforma): "bio:<slug>"
  // quando o lead chegou pelo rodapé "feito por atacadopro.com" de uma bio.
  landingSource   String?
  // ANÚNCIO que trouxe o cliente (Click-to-WhatsApp): código curto do post/
  // anúncio, tirado da prévia que o WhatsApp manda na primeira mensagem.
  // É a chave que liga o cliente à campanha — e que responde "quanto este
  // anúncio me deu" mesmo antes de existir campanha cadastrada.
  adRef           String?
  createdAt       DateTime     @default(now())

  tags          CustomerTag[]
  interests     CustomerInterest[]
  opportunities Opportunity[]
  conversations Conversation[]
  tasks         Task[]
  sales         Sale[]
  orders        Order[]
  events        CustomerEvent[]

  @@index([companyId])
  @@index([companyId, ownerId])
  @@index([companyId, adRef])
  // varredura diária de aniversariantes
  @@index([companyId, birthDate])
  abandonedCarts  AbandonedCart[]
}

model Tag {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#8b5cf6")

  customers CustomerTag[]

  @@unique([companyId, name])
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

// Produtos/categorias de interesse (vestidos, moda fitness, atacado...)
model Interest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  customers CustomerInterest[]

  @@unique([companyId, name])
}

model CustomerInterest {
  customerId String
  interestId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([customerId, interestId])
}

model Pipeline {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String  @default("Funil de vendas")

  stages Stage[]

  @@index([companyId])
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  color      String   @default("#6366f1")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)

  opportunities Opportunity[]
  originRules   OriginRule[]

  @@index([pipelineId])
}

enum OppStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id                  String    @id @default(cuid())
  nuvemshopCheckoutId String? // carrinho abandonado da Nuvemshop (não duplica)
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stageId             String
  stage               Stage     @relation(fields: [stageId], references: [id])
  title               String
  details             String? // lista completa de itens (ex.: sacola/carrinho abandonado), uma por linha
  value               Float     @default(0)
  status              OppStatus @default(OPEN)
  lostReason          String?
  ownerId             String?
  owner               User?     @relation("OppOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastInteractionAt   DateTime  @default(now())
  createdAt           DateTime  @default(now())
  closedAt            DateTime?

  tasks Task[]
  sales Sale[]
  order Order? // pedido gerado junto com esta oportunidade (catálogo)

  @@unique([companyId, nuvemshopCheckoutId])
  @@index([companyId, status])
  @@index([stageId])
}

enum ConversationStatus {
  OPEN
  WAITING_CLIENT
  WAITING_PAYMENT
  CLOSED
}

// Canal de comunicação (Communication Engine)
enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  EMAIL
  SMS
}

enum ConversationPriority {
  BAIXA
  NORMAL
  ALTA
}

model Conversation {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?                @relation("ConvAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  setorId        String? // setor do chamado (Central de Atendimento)
  setor          Setor?               @relation(fields: [setorId], references: [id], onDelete: SetNull)
  channel        Channel              @default(WHATSAPP)
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  unreadCount    Int                  @default(0)
  lastMessageAt  DateTime             @default(now())
  lastInboundAt  DateTime? // última msg do cliente → tempo aguardando vendedor
  lastOutboundAt DateTime? // última msg da loja → tempo aguardando cliente
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt // sync incremental da inbox

  messages Message[]
  orders   Order[]

  @@index([companyId, status])
  @@index([companyId, updatedAt])
}

enum MessageDirection {
  IN
  OUT
}

// NOTE = nota interna (visível só para a equipe, nunca enviada ao cliente)
enum MessageKind {
  TEXT
  NOTE
}

enum MessageMedia {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  TEMPLATE
}

// Ciclo de vida da entrega (Cloud API: sent → delivered → read)
enum MessageStatus {
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  REENVIADA
  RECEBIDA
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String? // id da mensagem no provedor (wamid...)
  channel        Channel          @default(WHATSAPP)
  direction      MessageDirection @default(OUT)
  kind           MessageKind      @default(TEXT)
  mediaType      MessageMedia     @default(TEXT)
  body           String
  mediaUrl       String?
  fileName       String?
  reaction       String? // emoji de reação
  replyToId      String? // resposta a outra mensagem
  replyTo        Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]        @relation("MessageReply")
  status         MessageStatus    @default(ENVIADA)
  error          String?
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  // QUANDO ESTA MENSAGEM MUDOU pela última vez (recibo ✓✓, edição,
  // apagada). É o que permite o sync incremental mandar só o que mudou
  // em vez do histórico inteiro da conversa a cada 3 segundos: recibo
  // não altera `createdAt`, então filtrar por data de criação perdia
  // justamente as atualizações de status.
  updatedAt      DateTime         @updatedAt @default(now())
  // recibos com horário (WhatsApp): quando o cliente RECEBEU e quando VIU
  deliveredAt    DateTime?
  readAt         DateTime?
  // edição (WhatsApp permite editar até ~15min) e "apagar para todos"
  editedAt       DateTime?
  revoked        Boolean          @default(false) // apagada para todos
  revokedBy      String? // "CUSTOMER" (o cliente apagou) | "STORE" (a loja apagou)

  @@index([conversationId, createdAt])
  // sync incremental da inbox: "o que mudou nesta conversa desde X"
  @@index([conversationId, updatedAt])
  @@index([externalId])
  // MESMA MENSAGEM NUNCA ENTRA DUAS VEZES.
  //
  // Antes a proteção era só "olha se já existe, depois grava" — e duas
  // entregas simultâneas do mesmo aviso do WhatsApp (o servidor reenvia
  // quando a resposta demora) passavam as duas, virando bolha duplicada na
  // conversa. Agora quem garante é o banco, que não tem corrida.
  // Mensagem nossa nasce sem `externalId` (nulo não conflita no Postgres) e
  // recebe o id verdadeiro quando o eco volta.
  @@unique([conversationId, externalId])
}

enum TemplateCategory {
  PRIMEIRO_ATENDIMENTO
  CATALOGO
  COBRANCA
  POS_VENDA
  RECOMPRA
  PROMOCAO
  CLIENTE_FRIO
  ANIVERSARIO
  OUTRO
}

model MessageTemplate {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  TemplateCategory @default(OUTRO)

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Communication Engine — eventos, credenciais e auditoria
// ---------------------------------------------------------------------------

// Log de todo tráfego da engine: webhooks recebidos, envios, erros, latência
model CommEvent {
  id         String   @id @default(cuid())
  companyId  String?
  channel    Channel  @default(WHATSAPP)
  direction  String // IN | OUT
  type       String // message.received | message.sent | status.update | webhook.error ...
  status     String // OK | ERRO
  payload    String? // JSON do que chegou/saiu
  response   String? // JSON da resposta do provedor
  error      String?
  durationMs Int      @default(0)
  attempts   Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([type])
}

// Credenciais por empresa — valores sensíveis criptografados (AES-256-GCM)
model CommSettings {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  activeProvider     String   @default("MOCK") // MOCK | CLOUD_API | EVOLUTION
  metaAppId          String?
  metaAppSecret      String? // criptografado
  businessManagerId  String?
  phoneNumberId      String?
  verifyToken        String? // criptografado
  accessToken        String? // criptografado
  webhookSecret      String? // criptografado
  instagramAccountId String?
  facebookPageId     String?
  telegramBotToken   String? // criptografado
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String? // criptografado
  updatedAt          DateTime @updatedAt

  // WhatsApp SEM API oficial (conexão estilo WhatsApp Web via Evolution)
  evolutionInstance     String? // nome da instância no servidor Evolution
  evolutionWebhookToken String?   @unique // identifica/autentica o webhook desta loja
  evolutionStatus       String    @default("DESCONECTADO") // DESCONECTADO | AGUARDANDO_QR | CONECTADO
  evolutionPhone        String? // número conectado (informativo)
  // Central de Atendimento: setor padrão dos chamados que entram por este número
  defaultSetorId        String?
  // mensagem do botão "enviar link do catálogo" ({nome} e {link} são trocados)
  catalogLinkMsg        String?
  // mensagem de confirmação ao montar um pedido ({nome}/{pedido}/{total})
  orderMsg              String?
  // Mensagens da lista "Quem chamar hoje" ({nome} e {dias} são trocados).
  // Cada loja fala do seu jeito — texto que não parece da loja soa como
  // robô e a cliente sente. Vazio = usa o padrão do sistema.
  msgAniversario        String?
  msgRecompra           String?
  msgPosVenda           String?
  msgPrimeiroContato    String?
  msgConversaParada     String?
  // vigia do WhatsApp: desde quando caiu e quando o último alerta foi enviado
  evolutionDownSince    DateTime?
  evolutionAlertAt      DateTime?
  // trava de segurança anti-banimento: espaçamento mínimo + teto diário
  waLastSentAt          DateTime?
  waSentDate            String? // dia (yyyy-mm-dd) do contador abaixo
  waSentToday           Int       @default(0)
}

/// Conexão da loja com a Nuvemshop (loja online). A Nuvemshop é a DONA do
/// estoque e dos produtos; o AtacadoPro espelha e devolve vendas do catálogo.
model NuvemshopConnection {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storeId          String    @unique // id da loja na Nuvemshop
  accessToken      String // criptografado
  storeUrl         String?
  status           String    @default("CONECTADO") // CONECTADO | ERRO | DESCONECTADO
  lastProductSync  DateTime?
  lastCheckoutSync DateTime?
  lastSyncReport   String    @default("{}") // resumo + pendências de vínculo (JSON)
  createdAt        DateTime  @default(now())
}

/// Conexão da loja com o sistema Jueri (ERP de semijoias/consignação).
/// Importa o catálogo via API: SKU, preços de varejo e atacado, estoque,
/// cor (com hexadecimal) e fotos. Token gerado pela cliente no Jueri.
model JueriConnection {
  id             String    @id @default(cuid())
  companyId      String    @unique
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteSistema String // ID do cliente no sistema Jueri
  token          String // Bearer token de integração
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
}

/// Cobrança da loja (visível só para o Super Admin). Cada cliente tem os
/// SEUS valores — não há preço fixo. Cobra-se implementação (uma vez) e
/// recorrência (mensal). `kind` define a etiqueta: TESTE, PAGANTE ou
/// CORTESIA (acesso vitalício grátis, que pode virar pago quando quiser).
/// `paidThrough` guarda a competência (mês) paga até — dia 1 do mês pago.
model CompanyBilling {
  id                   String    @id @default(cuid())
  companyId            String    @unique
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind                 String    @default("TESTE") // TESTE | PAGANTE | CORTESIA
  implementationFee    Float     @default(0) // valor de implementação (uma vez)
  implementationPaid   Boolean   @default(false)
  implementationPaidAt DateTime?
  monthlyFee           Float     @default(0) // valor da recorrência mensal
  // CICLO do contrato: de quanto em quanto tempo a loja paga a recorrência.
  // O valor mensal continua sendo o mesmo (é a régua do MRR); o ciclo diz
  // como a cobrança é feita — mensal, semestral (6x) ou anual (12x).
  cycle                String    @default("MENSAL") // MENSAL | SEMESTRAL | ANUAL
  dueDay               Int       @default(10) // dia do vencimento (1..28)
  paidThrough          DateTime? // recorrência paga ATÉ este mês (dia 1 da competência)
  notes                String? // acordo combinado (parcelas, descontos, observações)
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())

  payments BillingPayment[]
}

/// Histórico de pagamentos registrados manualmente pelo Super Admin. Alimenta
/// o "recebido no mês" e a prova de quando cada mês foi pago. Nunca apagado.
model BillingPayment {
  id          String         @id @default(cuid())
  billingId   String
  billing     CompanyBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  companyId   String // denormalizado para somar por período com facilidade
  kind        String // IMPLEMENTACAO | RECORRENCIA
  amount      Float
  competencia DateTime? // mês de referência (recorrência) — dia 1 da competência
  paidAt      DateTime       @default(now())
  note        String?
  createdAt   DateTime       @default(now())

  @@index([companyId, paidAt])
}

/// Aceite do termo de uso do WhatsApp sem API oficial — prova de que o
/// lojista foi informado dos riscos ANTES de conectar. Nunca é apagado.
model WhatsappConsent {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  userName    String
  userEmail   String
  userRole    String
  termVersion String
  termSha     String // hash do texto exibido (prova da versão lida)
  ip          String
  userAgent   String
  acceptedAt  DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Tracking Engine — Inteligência Comercial
// ---------------------------------------------------------------------------

// Visitante do catálogo (anônimo até informar o telefone; depois unificado)
model Visitor {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String? // preenchido no identify (unifica a navegação)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  visits      Int      @default(1)

  sessions TrackSession[]

  @@index([companyId, customerId])
}

// Sessão de navegação no catálogo (uma visita)
model TrackSession {
  id             String   @id @default(cuid())
  companyId      String
  visitorId      String
  visitor        Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  customerId     String? // denormalizado após identify
  ref            String? // ?ref=joao / campanha-verao / qr-vitrine
  channel        String   @default("direto") // instagram|google|facebook|whatsapp|qr|indicacao|site|direto|...
  sellerId       String? // vendedor dono do link
  campaignId     String? // campanha dona do link
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referer        String?
  device         String? // mobile|desktop|tablet
  os             String?
  browser        String?
  city           String?
  state          String?
  country        String?
  ipMasked       String? // LGPD: último octeto zerado
  replayId       String? // estrutura pronta p/ replay de sessão (futuro)
  startedAt      DateTime @default(now())
  lastEventAt    DateTime @default(now())
  pages          Int      @default(0)
  productsViewed Int      @default(0)
  cartAdds       Int      @default(0)
  cartRemoves    Int      @default(0)
  cartValue      Float    @default(0)
  converted      Boolean  @default(false) // enviou pedido

  events TrackEvent[]

  @@index([companyId, startedAt])
  @@index([companyId, sellerId])
  @@index([companyId, campaignId])
  @@index([visitorId])
  abandonedCart  AbandonedCart?
}

// Evento da jornada — SEMPRE gravado via Tracking Engine
model TrackEvent {
  id          String       @id @default(cuid())
  companyId   String
  sessionId   String
  session     TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String // page_view|category_view|product_view|image_zoom|color_select|size_select|qty_change|cart_add|cart_remove|cart_open|cart_close|checkout_start|order_submitted|order_abandoned|heartbeat
  productId   String?
  productName String?
  category    String?
  color       String?
  size        String?
  qty         Int?
  value       Float?
  meta        String? // JSON extra
  createdAt   DateTime     @default(now())

  @@index([companyId, type, createdAt])
  @@index([sessionId])
}

// CARRINHO ABANDONADO — a esteira de recuperação (tela Recuperação).
//
// Nasce do catálogo (sessão de navegação que encheu a sacola e não enviou)
// ou da Nuvemshop (checkout abandonado, via API). A 1ª mensagem pode sair
// sozinha (Company.recoveryAuto); o resto é trabalho da vendedora na esteira.
// O id serve de token do "link mágico" que REMONTA a sacola no catálogo
// (cuid não é adivinhável e o link só reabre itens, nunca dados da cliente).
model AbandonedCart {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source           String // CATALOGO | NUVEMSHOP
  trackSessionId   String?   @unique // sessão do catálogo que virou este carrinho
  trackSession     TrackSession? @relation(fields: [trackSessionId], references: [id], onDelete: SetNull)
  nsCheckoutId     String? // id do checkout abandonado na Nuvemshop
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            String    @default("[]") // JSON [{productId?,name,color,size,qty,price?}]
  value            Float     @default(0)
  checkoutUrl      String? // link de retomada da própria Nuvemshop (quando existir)
  status           String    @default("NOVO") // NOVO | CHAMADA | RECUPERADO | PERDIDO
  autoSentAt       DateTime? // 1ª mensagem automática enviada em
  contactedAt      DateTime? // vendedora chamou em
  recoveredAt      DateTime?
  recoveredOrderId String? // pedido pago que fechou a recuperação
  lostAt           DateTime?
  abandonedAt      DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([companyId, nsCheckoutId])
  @@index([companyId, status, abandonedAt])
}

// ============ IA DE VENDAS (módulo pago à parte) ============
//
// Entrega 1 (01/08/2026): o CÉREBRO da IA — o que a loja ensina (tom de
// marca, roteiro, políticas) — e a TRAVA DE USO por loja. A IA que responde
// de verdade chega nas próximas entregas (precisa da chave da API); tudo
// aqui já funciona sem chave nenhuma e nada nasce ligado sozinho.
//
// Configuração da IA de uma loja (1:1 com Company). Toggles todos nascem
// DESLIGADOS: ligar atendimento automático é decisão da loja, não nossa.
model AiSettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ---- chaves de comportamento (Entregas 2 e 3 leem daqui) ----
  atendente Boolean @default(false) // IA responde clientes sozinha
  copilot   Boolean @default(false) // IA sugere respostas para a vendedora
  // Relatórios da operação para o DONO DA PLATAFORMA (serviço de
  // acompanhamento de CRM, vendido à parte). Decisão do dono (01/08/2026):
  // "não vai enviar por enquanto, mas já pode ficar pronto para ativar".
  relatoriosAoDono Boolean @default(false)

  // ---- o cérebro: o que a loja ensina para a IA ----
  tomDeMarca String @default("") // como a marca fala (ex.: informal, com emoji, "amiga")
  roteiro    String @default("") // processo comercial passo a passo
  politicas  String @default("") // regras duras: troca, prazo, desconto máximo, pedido mínimo

  // ---- trava de uso (o plano vendido para a loja) ----
  // Conversas de IA inclusas por mês. Bateu o teto → a IA para e o
  // atendimento volta para as humanas; o excedente vira conversa de upgrade.
  limiteConversasMes Int @default(1000)

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

// Contador mensal de uso da IA por loja (mês no calendário de São Paulo,
// "YYYY-MM"). É a régua da trava E do custo real por loja no painel.
model AiUsage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mes       String // "2026-08" (calendário de SP — mesma régua das telas de dinheiro)
  conversas Int     @default(0) // conversas em que a IA participou no mês
  respostas Int     @default(0) // mensagens que a IA escreveu (atendente + copilot)
  // custo real somado em dólar (tokens × preço). Preenchido pela Entrega 2+;
  // aqui já existe para o painel de margem nascer com histórico desde o dia 1.
  custoUsd  Float   @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([companyId, mes])
  @@index([companyId])
}

// Campanhas/links inteligentes (cada um gera link + QR Code)
model TrackCampaign {
  id        String   @id @default(cuid())
  companyId String
  name      String
  slug      String // valor do ?ref=
  channel   String   @default("campanha") // instagram|qr|google|...
  ownerId   String? // responsável
  goal      Float    @default(0) // meta de faturamento
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, slug])
  @@index([companyId])
}

// Auditoria: quem alterou credenciais e quais campos (nunca os valores)
model CommAudit {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  userName  String
  action    String // ex.: "Atualizou credenciais"
  fields    String // nomes dos campos alterados, separados por vírgula
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum TaskType {
  LIGAR
  ENVIAR_CATALOGO
  COBRAR_PAGAMENTO
  POS_VENDA
  REATIVAR
  ENVIAR_NOVIDADES
  CONFIRMAR_ENTREGA
  FOLLOW_UP
  OUTRO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

model Task {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title         String
  // POR QUE esta tarefa existe. As automações escrevem aqui o motivo
  // ("não compra há 68 dias e costuma comprar a cada 40") — sem este
  // campo, o dado mais útil da tarefa era jogado fora na criação.
  description   String?
  type          TaskType     @default(FOLLOW_UP)
  dueAt         DateTime
  priority      TaskPriority @default(MEDIA)
  status        TaskStatus   @default(PENDENTE)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  autoRule      String? // preenchido quando a tarefa foi criada por automação
  // POR QUE a tarefa se fechou SOZINHA (o pagamento entrou, você já falou com
  // a cliente, o pedido foi entregue...). Nulo = quem concluiu foi gente.
  // Sem gravar o motivo, a tarefa sumia da lista sem explicação — e lista que
  // some sozinha sem dizer por quê é lista em que ninguém confia.
  autoDoneReason String?
  createdAt     DateTime     @default(now())

  @@index([companyId, status, dueAt])
}

model Sale {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sellerId      String?
  seller        User?        @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  orderId       String? // pedido de origem — cancelou o pedido, a venda sai junto
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  total         Float
  category      String?
  description   String?
  createdAt     DateTime     @default(now())

  @@index([companyId, createdAt])
}

enum CampaignStatus {
  RASCUNHO
  ATIVA
  CONCLUIDA
}

// Disparo de campanha: marca quais clientes já receberam a mensagem
// (o envio é pelo WhatsApp do vendedor; aqui fica o controle do progresso).
model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  sentAt     DateTime @default(now())

  @@unique([campaignId, customerId])
}

// Campanhas de reativação: filtro salvo como JSON (dias sem compra, tipo,
// cidade, ticket mínimo, interesse...) + mensagem a disparar.
model Campaign {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  filterJson String         @default("{}")
  message    String
  status     CampaignStatus @default(RASCUNHO)
  createdAt  DateTime       @default(now())

  sends CampaignSend[]

  @@index([companyId])
}

// Campanha de AQUISIÇÃO (módulo Marketing) — de onde os leads vêm, para
// medir canal/campanha do tráfego pago e orgânico. Diferente de `Campaign`
// (reativação por mensagem). `utmKey` é a etiqueta usada nos links
// rastreados (?utm_campaign=inverno) para casar a origem automaticamente.
model MarketingCampaign {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  channel   String   @default("INSTAGRAM") // INSTAGRAM | FACEBOOK | GOOGLE | WHATSAPP | TIKTOK | OUTRO
  utmKey    String // slug curto para casar com ?utm_campaign= dos links
  // ANÚNCIOS desta campanha (Click-to-WhatsApp): um por linha, colando o LINK
  // do post/anúncio ou só o código. Quando um cliente chega clicando num
  // anúncio daqui, a campanha é atribuída sozinha.
  adRefs    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  customers Customer[]

  @@unique([companyId, utmKey])
  @@index([companyId, active])
}

// Gestor de Bio (módulo Marketing) — a "página de links" do Instagram da loja,
// tipo Linktree só que com a identidade visual do catálogo. Uma por loja.
// Endereço público: /bio/<slug>. O rodapé "feito por atacadopro.com" leva o
// visitante ao formulário de leads da plataforma (canal de aquisição da bio).
model BioPage {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug      String   @unique // endereço público /bio/<slug> (nasce = slug da loja)
  published Boolean  @default(false)
  headline  String? // título grande (default = nome da loja)
  tagline   String? // subtítulo curto (default = tagline do catálogo)
  avatarUrl String? // foto/logo redonda no topo (default = logo do catálogo)
  coverUrl  String? // foto de capa (banner no topo, atrás do nome)
  hideCover Boolean @default(false) // esconder o banner de capa (bio mais compacta)
  // personalização visual própria da bio (null = herda do catálogo da loja)
  bgColor         String? // cor de fundo (base do gradiente)
  buttonColor     String? // cor dos botões
  buttonTextColor String? // cor do texto/ícone dos botões
  font            String? // fonte da bio (montserrat|inter|poppins|playfair|lora)
  buttonShape     String  @default("rounded") // rounded | pill | square
  // redes sociais (fileira de ícones) — só o @ / usuário, sem link completo
  instagram String?
  tiktok    String?
  youtube   String?
  facebook  String?
  // remarketing: pixel da bio (a loja persegue com anúncio quem visitou)
  metaPixelId String?
  gaId        String? // Google Analytics (G-XXXX)
  views     Int      @default(0) // visitas na página pública
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links BioLink[]

  @@index([companyId])
}

enum BioLinkType {
  CATALOGO // catálogo público da loja
  WHATSAPP // abre a conversa no WhatsApp da loja
  SITE // site/e-commerce próprio da loja
  EXTERNO // qualquer link (Instagram, Shopee, promoção...)
}

model BioLink {
  id        String      @id @default(cuid())
  bioPageId String
  bioPage   BioPage     @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  companyId String // denormalizado para escopo/consultas
  title     String
  subtitle  String? // linha de apoio opcional
  type      BioLinkType @default(EXTERNO)
  url       String? // destino (SITE/EXTERNO); vazio usa o padrão do tipo
  imageUrl  String? // miniatura (layout normal) ou banner (layout banner)
  layout    String      @default("normal") // normal (ícone+texto) | banner (imagem larga)
  featured  Boolean     @default(false) // botão em destaque (brilho + selo)
  order     Int         @default(0)
  active    Boolean     @default(true)
  clicks    Int         @default(0) // cliques rastreados (via /api/bio/go/<id>)
  createdAt DateTime    @default(now())

  @@index([bioPageId, order])
}

// Eventos com DATA (pra filtrar métricas por período). Os contadores acumulados
// (BioPage.views, BioLink.clicks) continuam pro total geral; estes registram
// cada visita/clique com carimbo de data pra montar relatório por período.
model BioView {
  id        String   @id @default(cuid())
  bioPageId String
  companyId String
  createdAt DateTime @default(now())

  @@index([bioPageId, createdAt])
}

model BioClick {
  id        String   @id @default(cuid())
  bioLinkId String
  bioPageId String
  companyId String
  createdAt DateTime @default(now())

  @@index([bioPageId, createdAt])
  @@index([bioLinkId, createdAt])
}

// Catálogo de CAMPANHA: uma vitrine à parte com produtos selecionados e um
// desconto próprio (%). O catálogo geral continua intacto; a campanha tem
// link/QR próprios (catalago.net/<loja>/c/<campanha>) e o desconto é
// recalculado no servidor na hora do pedido (nunca confiamos no navegador).
model PromoCatalog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  discount  Int // % de desconto sobre os preços do catálogo geral
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products PromoCatalogProduct[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model PromoCatalogProduct {
  id        String       @id @default(cuid())
  promoId   String
  promo     PromoCatalog @relation(fields: [promoId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promoId, productId])
}

// ---------------------------------------------------------------------------
// Catálogo de produtos + Pedidos
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  category       String
  brand          String?
  collection     String?
  description    String?
  videoUrl       String?
  costPrice      Float    @default(0)
  wholesalePrice Float    @default(0) // preço atacado
  retailPrice    Float    @default(0) // preço varejo
  minQuantity    Int      @default(1) // qtd mínima (atacado)
  active         Boolean  @default(true)
  tags           String? // separadas por vírgula
  // Módulo Envios: peso da peça em GRAMAS para cotar frete. Vem sozinho da
  // Nuvemshop (quando preenchido lá) e nunca sobrescreve o valor digitado à
  // mão. Produto sem peso usa o padrão da categoria ou da loja.
  weightGrams    Int?
  nuvemshopId    String? // id do produto na Nuvemshop (loja integrada)
  jueriId        String? // id do produto no Jueri (integração)
  createdAt      DateTime @default(now())

  variants ProductVariant[]
  images   ProductImage[]
  items    OrderItem[]
  promoIn  PromoCatalogProduct[]

  @@unique([companyId, sku])
  @@unique([companyId, nuvemshopId])
  @@unique([companyId, jueriId])
  @@index([companyId, active])
  @@index([companyId, category])
}

// Grade: cada combinação cor × tamanho com estoque próprio
model ProductVariant {
  id                 String  @id @default(cuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nuvemshopId        String? // id da variação na Nuvemshop
  nuvemshopProductId String? // id do PRODUTO na Nuvemshop (modo produto-por-cor)
  sku                String? // SKU da variação — chave universal de vínculo com a loja online
  color              String
  size               String
  stock              Int     @default(0)

  items     OrderItem[]
  movements InventoryMovement[]

  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
  // CAPA POR COR (pedido da Entre Linhas, 03/08/2026): a foto pode ser
  // etiquetada com a cor que ela mostra. No catálogo, o card de cada cor usa
  // a foto DAQUELA cor (sem etiqueta, cai na capa geral — nada quebra).
  // Vem sozinha da Nuvemshop (variant.image_id) ou da etiqueta no editor.
  color     String?

  @@index([productId])
}

// Biblioteca de imagens da loja: fotos guardadas soltas (não presas a um
// produto). Serve pra reaproveitar imagens, guardar uma foto antes de excluir
// um produto, etc. `url` guarda a foto como data-URL (base64), igual às fotos
// de produto. Recurso pago/gated (Company.mediaLibraryEnabled).
model MediaAsset {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String? // nome amigável dado pela lojista (opcional)
  url       String // data-URL (base64) ou link externo
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum OrderStatus {
  ORCAMENTO
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PRODUCAO
  SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Order {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number         Int // sequencial por empresa
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId       String?
  seller         User?         @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // Oportunidade do funil criada junto com este pedido (catálogo). Vínculo
  // 1-para-1: excluir o pedido apaga essa oportunidade e vice-versa.
  opportunityId  String?       @unique
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  status         OrderStatus   @default(ORCAMENTO)
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  // Quando o desconto foi digitado em PORCENTAGEM, guarda o percentual: é o
  // que permite recalcular sozinho quando as peças do pedido mudam ("10% de
  // desconto" continua 10% depois de entrar mais uma blusa). Nulo = o valor
  // em reais é fixo.
  discountPct    Float?
  // Acréscimo (juros de parcelamento, taxa de urgência, personalização).
  // É dinheiro que FICA na loja: conta como venda e entra na comissão.
  surcharge      Float         @default(0)
  surchargePct   Float?
  shippingFee    Float         @default(0)
  // VALOR VENDIDO = subtotal − desconto + acréscimo. É a coluna que TODA
  // métrica de faturamento soma, e a base da comissão. O frete fica de fora
  // de propósito: é dinheiro da transportadora atravessando a loja.
  netTotal       Float         @default(0)
  // O QUE A CLIENTE PAGA = valor vendido + frete. Serve para cobrar (Pix,
  // PDF, nota) — nunca para somar faturamento.
  total          Float         @default(0)
  notes          String?
  stockDeducted  Boolean       @default(false) // estoque só baixa quando o pedido é pago
  source         String        @default("CATALOGO") // CATALOGO | NUVEMSHOP | MANUAL
  nuvemshopId    String? // id do pedido na Nuvemshop (nunca importa duplicado)
  // PROTOCOLO DO ENVIO (catálogo público): código sorteado no aparelho da
  // cliente ANTES de mandar o pedido. É o que permite o catálogo insistir —
  // tentar de novo, e até na próxima visita — sem risco de criar o mesmo
  // pedido duas vezes. Sem isso, um tropeço de internet fazia a mensagem
  // chegar no WhatsApp da vendedora e o pedido sumir, sem ninguém saber.
  clientRef      String?
  // Sessão de navegação que gerou o pedido (Tracking Engine). É o que
  // permite à Inteligência somar FATURAMENTO PAGO por canal/campanha — a
  // auditoria de 06/08/2026 pegou o ranking somando valor de sacola enviada
  // (não paga, vinda do navegador) rotulado de faturamento.
  trackSessionId String?
  // NF-e emitida via Bling (a nota é da loja; o Bling é o emissor)
  nfeBlingId     String? // id da NF-e no Bling
  nfeNumber      String? // número da nota quando autorizada
  nfeStatus      String? // EMITINDO | AUTORIZADA | ERRO
  nfeUrl         String? // link do DANFE/PDF quando disponível
  createdAt      DateTime      @default(now())
  // Última mexida no pedido. Serve à conferência da agenda: prova de que a
  // entrega/cancelamento aconteceu DEPOIS de a tarefa nascer (prova velha não
  // fecha tarefa nova). O dinheiro já tinha data própria em `paidAt`.
  updatedAt      DateTime      @updatedAt @default(now())
  // DATA DO DINHEIRO: quando o pedido virou PAGO. É por ela que TODA métrica
  // de faturamento é somada (não pela data em que o orçamento foi montado) —
  // assim o mês bate com o extrato e um mês fechado nunca mais muda de valor.
  // Carimbada na transição para PAGO e limpa se o pedido voltar atrás.
  paidAt         DateTime?

  items    OrderItem[]
  payments Payment[]
  shipping Shipping?
  events   OrderEvent[]
  sales    Sale[]

  @@unique([companyId, number])
  @@unique([companyId, nuvemshopId])
  @@unique([companyId, clientRef])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, paidAt])
  @@index([companyId, trackSessionId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // snapshot no momento da venda (produto pode mudar depois)
  name      String
  sku       String?
  imageUrl  String?
  color     String?
  size      String?
  quantity  Int
  unitPrice Float
  total     Float

  @@index([orderId])
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  CHEQUE
  DINHEIRO
  OUTRO
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  ESTORNADO
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(PIX)
  status    PaymentStatus @default(PENDENTE)
  amount    Float
  pixKey    String? // chave usada no BR Code do orçamento
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  // Cobrança automática (Mercado Pago): confirmação sozinha via webhook
  provider      String    @default("MANUAL") // MANUAL | MERCADO_PAGO
  mpPaymentId   String?   @unique // id do pagamento no Mercado Pago
  pixCopiaECola String? // código Pix copia-e-cola gerado pelo MP
  pixQrBase64   String? // QR Code (imagem base64) gerado pelo MP
  checkoutUrl   String? // link de pagamento (cartão parcelado — Checkout Pro)
  feeAmount     Float     @default(0) // taxa da plataforma embutida (R$)
  dueAt         DateTime? // vencimento (contas a receber / venda a prazo)

  @@index([orderId])
  @@index([status, dueAt])
}

/// Conexão da loja com o Mercado Pago (modo marketplace): a loja autoriza o
/// app da plataforma via OAuth; as cobranças saem NA CONTA DELA já com a
/// taxa da plataforma (application_fee) separada automaticamente.
model MercadoPagoConnection {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mpUserId     String // id do vendedor no Mercado Pago
  accessToken  String // criptografado (AES-256-GCM)
  refreshToken String? // criptografado
  publicKey    String?
  expiresAt    DateTime? // validade do access token (renovado sozinho)
  feePercent   Float? // taxa da plataforma desta loja (null = padrão global)
  webhookToken String    @unique // autentica o webhook desta loja
  // cartão de crédito: limite de parcelas oferecido no link de pagamento.
  // "Sem juros" é configuração da CONTA Mercado Pago da loja (Custos de
  // parcelamento) — o link respeita automaticamente o que ela definir lá.
  maxInstallments Int    @default(12)
  connectedAt  DateTime  @default(now())
}

/// Conexão da loja com o Bling (ERP): emissão de NF-e a partir do pedido.
/// OAuth v3 — tokens criptografados, renovados sozinhos.
model BlingConnection {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessToken  String // criptografado
  refreshToken String // criptografado
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
}

model Shipping {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       String? // transportadora, motoboy, correios, retirada...
  trackingCode String?
  address      String?
  city         String?
  state        String?
  zip          String?
  cost         Float     @default(0)
  shippedAt    DateTime?
  deliveredAt  DateTime?

  // Frete comprado pelo módulo Envios (Melhor Envio) — a etiqueta é da loja
  meOrderId    String? // id do envio no Melhor Envio
  meService    String? // serviço (PAC, SEDEX, .Package...)
  meCarrier    String? // transportadora (Correios, Jadlog...)
  mePrice      Float? // valor pago pela etiqueta
  meStatus     String? // COMPRADO | ETIQUETA | POSTADO | ENTREGUE | CANCELADO
  labelUrl     String? // link de impressão da etiqueta
  weightKg     Float? // peso usado na cotação (auditoria)
}

// Conexão da loja com o Melhor Envio (módulo Envios, pago à parte).
// Tokens SEMPRE criptografados. Os dados do remetente saem impressos na
// etiqueta; os padrões de embalagem cobrem produto sem peso cadastrado.
model MelhorEnvioConnection {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessToken  String // criptografado (AES-256-GCM)
  refreshToken String? // criptografado
  expiresAt    DateTime?
  connectedAt  DateTime  @default(now())

  // Remetente da etiqueta (pré-preenchido da conta Melhor Envio; editável)
  fromName       String?
  // mesma regra do cliente: a transportadora pede CPF e CNPJ em campos
  // diferentes, então a loja guarda os dois (CNPJ da empresa + CPF do titular)
  fromCpf        String?
  fromCnpj       String?
  fromPhone      String?
  fromEmail      String?
  fromZip        String?
  fromStreet     String?
  fromNumber     String?
  fromComplement String?
  fromDistrict   String?
  fromCity       String?
  fromState      String? // sigla (MG, SP...)

  // Padrões de embalagem para cotação
  defaultWeightGrams Int @default(300) // peso por peça sem cadastro (g)
  boxWidthCm         Int @default(30) // caixa padrão do atacado
  boxHeightCm        Int @default(15)
  boxLengthCm        Int @default(40)
  categoryWeights    String @default("") // JSON {"Vestidos":350,...} — peso padrão por categoria (g)
}

// Timeline do pedido: criação, mudanças de status, pagamento, envio...
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String // CRIADO, STATUS, PAGAMENTO, ENVIO, NOTA
  description String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model InventoryMovement {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  type      MovementType
  quantity  Int // sempre positivo; o tipo dá a direção
  reason    String?
  createdAt DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([variantId])
}

// Inscrição de notificação push (Web Push) — o celular do lojista recebe um
// aviso quando um pedido vira PAGO. Uma por dispositivo/navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

// ============================================================================
// MÓDULO PRODUÇÃO (pago à parte) — inteligência de rendimento têxtil.
// Cada corte fechado vira "experiência" do motor de previsão: nada de regra
// fixa, tudo aprendido do histórico da própria confecção.
// ============================================================================

/// Tecido (o "modelo" do material — os rolos são as unidades físicas dele)
model Fabric {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String? // código interno
  type        String? // malha, plano, tule...
  supplier    String? // fornecedor
  grammage    Int? // gramatura (g/m²)
  composition String? // ex.: 90% poliamida 10% elastano
  widthM      Float // largura útil em metros
  yieldMPerKg Float // rendimento: metros por kg
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolls   FabricRoll[]

  @@index([companyId])
}

/// Rolo/lote físico de um tecido — rastreado individualmente (o rendimento
/// REAL medido nos cortes é comparado ao prometido na ficha do tecido)
model FabricRoll {
  id          String   @id @default(cuid())
  fabricId    String
  color       String
  lotCode     String? // lote do fornecedor
  weightKg    Float // peso original
  remainingKg Float // quanto ainda não foi cortado
  pricePerKg  Float // valor pago por kg
  arrivedAt   DateTime @default(now())
  notes       String?

  fabric   Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  cutRolls CutRoll[]

  @@index([fabricId])
}

/// Rolo usado dentro de um corte — o corte SEMPRE pode ter vários rolos
/// (várias cores enfestadas juntas), cada um com seu peso destinado.
/// A peça de cada cor paga o rolo da própria cor: custo por cor exato.
model CutRoll {
  id        String @id @default(cuid())
  cutId     String
  rollId    String
  plannedKg Float // peso deste rolo destinado ao corte

  cut  CutTicket  @relation(fields: [cutId], references: [id], onDelete: Cascade)
  roll FabricRoll @relation(fields: [rollId], references: [id])

  @@index([cutId])
  @@index([rollId])
}

/// Corte — código sequencial por loja. Ciclo: ABERTO → (PARCIAL com projeção)
/// → FECHADO com previsto × real × erro (o erro treina o motor).
model CutTicket {
  id            String   @id @default(cuid())
  companyId     String
  code          Int // Corte #000001
  status        String   @default("ABERTO") // ABERTO | PARCIAL | FECHADO
  date          DateTime @default(now())
  operator      String?
  tableName     String? // mesa utilizada
  tableLengthM  Float? // comprimento da mesa
  sourceScrapId String? // sobra reaproveitada como matéria-prima (opcional)
  plannedKg     Float // peso TOTAL destinado ao corte (soma dos rolos)
  usedKg        Float    @default(0) // peso efetivamente cortado até agora
  planName      String? // plano de corte
  productName   String? // modelo produzido
  gradeInfo     String? // grade de tamanhos (ex.: "P2 M2 G2 GG1")
  lengthM       Float? // metros de tecido calculados
  sheets        Int? // folhas completas na mesa

  piecesFirst    Int? // produção real da parte já cortada
  predictedTotal Float? // PROJEÇÃO do total (parte cortada + restante)
  predictedMin   Float?
  predictedMax   Float?
  predictedBasis Int    @default(0) // em quantos cortes parecidos se baseou
  piecesRest     Int? // produção do restante (no fechamento)
  piecesTotal    Int? // produção real final
  errorPieces    Float? // real − previsto (alimenta o aprendizado)

  // Aproveitamento por pesagem das peças (método da balança): peso em peças
  // ÷ peso cortado. O desperdício sai por SUBTRAÇÃO — ninguém pesa farelo.
  piecesWeightKg Float? // Σ (quantidade × peso unitário) dos modelos pesados
  utilizationPct Float? // % do tecido que virou peça
  wasteKg        Float? // desperdício apurado (cortado − peças)

  fabricCost   Float     @default(0) // custo do tecido usado (R$)
  costItems    String    @default("[]") // custos extras [{name, value}] por peça
  costPerPiece Float? // custo industrial final por peça
  notes        String?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolls       CutRoll[] // rolos/cores usados no corte
  occurrences CutOccurrence[]
  scraps      FabricScrap[]
  items       CutItem[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

/// Modelo produzido dentro de um corte (um corte pode sair com vários SKUs).
/// O peso unitário da peça permite o método da balança: pesa-se a produção
/// pronta e o aproveitamento/desperdício saem por subtração.
model CutItem {
  id           String  @id @default(cuid())
  cutId        String
  stage        String  @default("PRIMEIRA") // PRIMEIRA | RESTO (parte do corte)
  name         String // modelo (ex.: "Blusa Tule")
  color        String? // cor da peça (casa com a cor do rolo usado)
  size         String? // tamanho cortado (P, M, G...)
  pieces       Int // quantidade produzida
  pieceWeightG Float? // peso unitário da peça (gramas) — opcional

  cut CutTicket @relation(fields: [cutId], references: [id], onDelete: Cascade)

  @@index([cutId])
}

/// Estoque de COSTURA — a estação entre o corte e a peça pronta.
/// Corte não é peça produzida: o cortado entra aqui (visível pra vendas e
/// adm: "não tem no estoque, mas está cortada"); quando a peça é montada e
/// conferida, o lançamento dá ENTRADA no estoque real (AtacadoPro →
/// Nuvemshop automático) e baixa daqui.
model SewingItem {
  id          String   @id @default(cuid())
  companyId   String
  cutId       String? // corte de origem
  cutCode     Int? // nº do corte (sobrevive se o corte sumir)
  productName String // modelo cortado
  color       String? // cor do tecido
  size        String? // tamanho
  cutPieces   Int // peças cortadas (entraram na costura)
  donePieces  Int      @default(0) // já montadas/conferidas/lançadas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

/// Ocorrência durante o enfesto (furo, mancha, rasgo...) — NÃO é perda
/// automática: o material vira uma sobra reaproveitável.
model CutOccurrence {
  id          String   @id @default(cuid())
  cutId       String
  type        String
  description String?
  lostKg      Float    @default(0)
  lostM       Float    @default(0)
  photoUrl    String?
  createdAt   DateTime @default(now())

  cut CutTicket @relation(fields: [cutId], references: [id], onDelete: Cascade)

  @@index([cutId])
}

/// Sobra de tecido — nasce de ocorrências e pontas de corte; pode ser
/// reaproveitada em cortes futuros. A geometria importa tanto quanto o peso.
model FabricScrap {
  id          String   @id @default(cuid())
  companyId   String
  cutId       String? // corte de origem
  fabricName  String
  color       String?
  grammage    Int?
  widthM      Float?
  weightKg    Float
  estimatedM  Float? // comprimento estimado
  value       Float    @default(0) // valor financeiro parado (R$)
  geometry    String? // FAIXA | RETANGULO | IRREGULAR | RETALHOS
  quality     String? // BOA | REGULAR | RUIM
  status      String   @default("DISPONIVEL") // DISPONIVEL | RESERVADA | CONSUMIDA | DESCARTADA | PERDA
  usedInCutId String? // corte que consumiu a sobra
  notes       String?
  createdAt   DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cut     CutTicket? @relation(fields: [cutId], references: [id])

  @@index([companyId, status])
}

/// Modelo de corte importado do CAD (Audaces .adsx ou DXF): nome, grade,
/// peças com medidas (e contornos, no DXF) e a miniatura do molde.
/// É a matéria-prima do Plano de Corte Inteligente.
model CutPlanModel {
  id        String   @id @default(cuid())
  companyId String
  name      String
  source    String // ADSX | DXF
  thumbnail String? // data-URL da miniatura que vem dentro do .adsx
  sizes     String // JSON: ordem da grade ["P","M","G","GG"]
  pieces    String // JSON: peças (nome, pano TEC/FOR, medidas por tamanho, contorno)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    CutPlanRun[]

  @@index([companyId])
}

/// Plano de corte: um JOB de otimização retomável. A tela dispara rodadas
/// de cálculo (cada uma retoma `state`), o melhor resultado até agora fica
/// em `result`, e o progresso (tempo/tentativas) alimenta a barra ao vivo.
/// Aceita VÁRIOS modelos no mesmo plano (lista em params.itens) — modelId
/// guarda só o primeiro, por compatibilidade/exibição.
model CutPlanRun {
  id        String   @id @default(cuid())
  companyId String
  modelId   String? // primeiro modelo do plano (planos multi têm a lista no params)
  name      String? // apelido do corte ("Corte semana 32")
  status    String   @default("CONCLUIDO") // EM_ANDAMENTO | CONCLUIDO | CANCELADO
  mode      String? // RAPIDO | NORMAL | CAPRICHADO
  budgetMs  Int      @default(0) // orçamento de cálculo (tempo de "pensar")
  elapsedMs Int      @default(0) // cálculo já gasto (soma das rodadas)
  attempts  Int      @default(0) // encaixes completos avaliados
  state     String   @default("") // JSON: EstadoOtimizacao (retomada exata)
  params    String // JSON: ParametrosPlano + itens [{modelId, grade, pecasDesligadas}]
  result    String // JSON: ResultadoPlano (melhor plano até agora)
  createdAt DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  model   CutPlanModel? @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([modelId])
}

/// Configurações da Produção — tudo cadastrável, nada fixo no código.
model ProductionSettings {
  id              String @id @default(cuid())
  companyId       String @unique
  tables          String @default("[]") // mesas [{name, lengthM}]
  operators       String @default("[]") // ["Maria", "João"...]
  occurrenceTypes String @default("[\"Furo\",\"Mancha\",\"Defeito\",\"Falta de largura\",\"Rasgo\",\"Borda ruim\",\"Torção\",\"Outro\"]")
  costItems       String @default("[]") // custos extras padrão [{name, value}] por peça
}

/// Facção de costura (oficina externa) — nome, contato e preço por peça.
/// O enviado × devolvido de cada lote alimenta o ranking de facções.
model SewingFaction {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  contact       String?
  pricePerPiece Float    @default(0) // R$ por peça costurada
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  batches SewingBatch[]

  @@index([companyId])
}

/// Lote de costura (romaneio): peças saem do estoque de costura pra costura
/// interna ou pra facção, com etiqueta e conferência de volta. Voltas podem
/// ser parciais; ao fechar, o que não voltou fica na conta da facção.
model SewingBatch {
  id          String    @id @default(cuid())
  companyId   String
  code        Int // L-000001
  kind        String    @default("COSTURA") // COSTURA | CONSERTO
  destination String    @default("INTERNA") // INTERNA | FACCAO
  factionId   String?
  status      String    @default("ENVIADO") // ENVIADO | PARCIAL | FECHADO
  sentAt      DateTime  @default(now()) // data do envio (editável)
  closedAt    DateTime? // data do recebimento/fechamento (editável)
  notes       String?

  // Responsáveis (quem entregou na facção, quem conferiu a volta)
  sentBy     String?
  receivedBy String?

  // Prazo combinado de devolução — alimenta o alerta de lote atrasado
  dueBackDate DateTime?

  // Pagamento da facção
  paymentStatus String    @default("PENDENTE") // PENDENTE | PAGO
  dueDate       DateTime? // previsão de pagamento
  paidAt        DateTime? // quando foi efetivamente paga
  paidAmount    Float? // valor pago (pode divergir do calculado)
  paymentNotes  String? // forma de pagamento, comprovante, observações

  faction SewingFaction?    @relation(fields: [factionId], references: [id])
  items   SewingBatchItem[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
}

/// Item do lote: um SKU com a quantidade enviada e as voltas acumuladas.
/// faltantes = enviadas − boas − defeito (apuradas no fechamento).
model SewingBatchItem {
  id          String  @id @default(cuid())
  batchId     String
  productName String
  color       String?
  size        String?
  sent        Int // peças enviadas
  good        Int     @default(0) // voltaram boas (já lançadas no estoque)
  defect      Int     @default(0) // voltaram com defeito
  /// Custo de costura por peça DESTE modelo NESTE lote — congelado no
  /// envio (cópia do preço da facção) e editável depois. Preço histórico:
  /// mudar a tabela da facção hoje NÃO altera o custo dos lotes passados.
  /// 0 = lote antigo, sem snapshot → cai no preço atual da facção.
  pricePerPiece Float @default(0)

  batch SewingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

/// Peças com defeito de costura: descartar, guardar ou mandar consertar.
model DefectItem {
  id          String   @id @default(cuid())
  companyId   String
  batchId     String? // lote de origem
  productName String
  color       String?
  size        String?
  pieces      Int
  status      String   @default("AGUARDANDO") // AGUARDANDO | DESCARTADA | EM_CONSERTO | RESOLVIDA
  notes       String?
  createdAt   DateTime @default(now())

  @@index([companyId, status])
}

/// MÓDULO CONTRATADO POR UMA LOJA — com preço e histórico.
///
/// As 5 chavinhas em `Company` (productionEnabled, marketingEnabled...) ligam
/// e desligam o módulo, mas NÃO têm preço nem data: ativar era um clique e
/// cobrar era lembrar de somar na mensalidade de cabeça. Um dia esquece.
///
/// Aqui fica o HISTÓRICO, não o estado: responde "desde quando ela tem
/// Produção?", permite cobrar proporcional no mês da ativação, preserva o
/// preço antigo de quem já contratou quando a tabela subir, e — o principal —
/// faz o MRR ser CALCULADO (mensalidade base + módulos ativos) em vez de
/// digitado à mão.
model CompanyModule {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// chave do módulo: PRODUCAO | MARKETING | BIBLIOTECA | ENVIOS | PLANO_CORTE | INTELIGENCIA
  modulo     String
  /// quanto ESTA loja paga por mês por este módulo (0 = cortesia)
  priceMonth Float     @default(0)
  /// preço de tabela na data da contratação — mostra quanto de desconto foi
  /// dado, número que hoje não existe em lugar nenhum
  listPrice  Float     @default(0)
  activatedAt   DateTime  @default(now())
  /// preenchido quando o módulo é desligado (a linha nunca é apagada)
  deactivatedAt DateTime?
  notes      String?

  @@unique([companyId, modulo, activatedAt])
  @@index([companyId, deactivatedAt])
}

/// O ANÚNCIO EM SI — link, título e texto do criativo.
///
/// Quando a cliente chega por um Click-to-WhatsApp, o Meta manda junto a
/// prévia do anúncio. O sistema extraía dela um CÓDIGO curto e jogava o resto
/// fora: sobrava "dbn-u8qsqk4" na tela, que não abre nada e não diz que
/// anúncio é. Pior: o código vai para minúsculas, e link de Instagram
/// diferencia maiúsculas — não dá nem para remontar o endereço depois.
///
/// Aqui fica o criativo de verdade, uma linha por anúncio: dá para clicar e
/// ver, e para reconhecer o anúncio pelo título sem sair do sistema.
model AdCreative {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// mesmo código usado em Customer.adRef (a chave que casa com a campanha)
  adRef      String
  /// endereço ORIGINAL do anúncio, com maiúsculas preservadas
  sourceUrl  String?
  /// id do anúncio no Meta, quando vier
  sourceId   String?
  title      String?
  body       String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([companyId, adRef])
  @@index([companyId])
}
