# ============================================================================
# AtacadoPro — variáveis de ambiente
#
# Este arquivo é o MAPA do que o sistema lê. Ele documentava 3 variáveis
# enquanto o código lia mais de 30 — quem fosse configurar produção não tinha
# como saber o que faltava, e integração pronta ficava desligada sem ninguém
# entender por quê.
#
# Em produção os valores ficam na Vercel (Settings → Environment Variables),
# NUNCA neste arquivo e nunca num commit.
# ============================================================================

# ---------------------------------------------------------------- OBRIGATÓRIO
# Banco de dados — PostgreSQL (dev e produção)
# Ex. local:   postgresql://usuario:senha@localhost:5433/vesticrm?schema=public
# Ex. Neon:    postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/vesticrm?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5433/vesticrm?schema=public"

# Segredo das sessões (JWT). OBRIGATÓRIO em produção, mín. 16 caracteres.
# Gere um: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte-de-32-chars"

# Segredo que criptografa as credenciais das integrações no banco.
# Se não definir, usa o AUTH_SECRET.
# CRED_SECRET="outro-segredo-forte"


# ------------------------------------------------------------------ SEGURANÇA
# Protege as rotas públicas que RECEBEM leads e mensagens
# (/api/intake/* e /api/whatsapp/webhook).
#
# ATENÇÃO: sem esta variável a verificação é PULADA e as rotas ficam abertas —
# qualquer pessoa que saiba o slug da loja (que é público, aparece no link do
# catálogo) consegue criar cliente, conversa e tarefa dentro dela.
# Gere um: openssl rand -base64 32
INTAKE_SECRET=""

# Protege as tarefas agendadas (/api/cron/*) chamadas pela Vercel.
CRON_SECRET=""


# ------------------------------------------------------------------- ENDEREÇO
# Endereço público do app (usado nos retornos de OAuth e nos links).
APP_URL="https://www.atacadopro.com"
# Domínio dedicado aos catálogos (links curtos: dominio.com/nome-da-loja).
CATALOG_DOMAIN="catalago.net"
# Para onde mandar quem acessa a raiz do domínio de catálogos.
MAIN_SITE_URL="https://www.atacadopro.com"


# ------------------------------------------------------------------- WHATSAPP
# Servidor Evolution (WhatsApp não-oficial, conexão por QR Code).
EVOLUTION_URL=""
EVOLUTION_KEY=""

# WhatsApp Cloud API (Meta, oficial) — caminho alternativo, hoje sem uso.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""


# ---------------------------------------------- NOTIFICAÇÕES NO CELULAR (PWA)
# Push do app instalado. Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@atacadopro.com"


# ---------------------------------------------------------------- PAGAMENTOS
# Mercado Pago (Pix com confirmação automática + taxa da plataforma).
# Criar o app em: https://www.mercadopago.com.br/developers/panel
# Redirect/callback: https://www.atacadopro.com/api/mercadopago/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Taxa da plataforma por cobrança, em PERCENTUAL (0.5 = 0,5%).
PLATFORM_FEE_PCT="0.5"


# -------------------------------------------------------------------- FISCAL
# Bling (emissão de NF-e).
# Criar o app em: https://developer.bling.com.br
# Redirect/callback: https://www.atacadopro.com/api/bling/callback
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""


# -------------------------------------------------------------------- ENVIOS
# Melhor Envio (cotação, etiqueta e rastreio).
# Criar o app em: https://melhorenvio.com.br (área do desenvolvedor)
# Redirect/callback: https://www.atacadopro.com/api/melhorenvio/callback
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
# "1" usa o ambiente de testes do Melhor Envio (sandbox).
MELHOR_ENVIO_SANDBOX=""


# --------------------------------------------------------- PRODUTO E ESTOQUE
# Nuvemshop (quando conectada, a Nuvemshop é a DONA do estoque).
NUVEMSHOP_CLIENT_ID=""
NUVEMSHOP_CLIENT_SECRET=""
# NUVEMSHOP_API_BASE=""    # só para apontar outro ambiente
# NUVEMSHOP_AUTH_BASE=""

# Jueri (sincronização 2x/dia). O token é por loja, guardado no banco.
# JUERI_API_BASE=""


# ------------------------------------------------------------ PRIMEIRO ACESSO
# Usado UMA vez pelo bootstrap para criar o Super Admin inicial.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Trava de segurança: o seed NUNCA roda em produção sem isto — e não deve
# rodar, porque ele zera/duplica dados de lojas reais.
# ALLOW_PROD_SEED=""
